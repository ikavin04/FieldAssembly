# ==============================================================================
# FieldVoice — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env for backend configuration.
# For frontend, copy the VITE_* variable to frontend/.env.local (optional in dev).
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# AssemblyAI API Key — Required for generating ephemeral voice session tokens.
# Keep this secret on the server; NEVER expose in client-side code.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# PostgreSQL Database Connection String
# Local example:    postgresql://postgres:your_password@localhost:5432/fieldvoice
# Supabase example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://username:password@host:port/database

# Flask Environment: 'development' or 'production'
FLASK_ENV=development

# Application Secret Key — Set to a secure random string in production
SECRET_KEY=change-me-to-a-secure-random-secret

# Allowed Frontend Origin(s) for CORS (comma-separated or single URL)
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local or Vercel Environment Variables)
# ------------------------------------------------------------------------------

# Backend API base URL
# Local dev:  leave empty (Vite dev server proxies /api) or http://localhost:5000
# Production: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000
